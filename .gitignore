# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# database — TRACKED (essential for sandbox recovery)
# The SQLite DB contains all notes, users, categories, and tags.
# Without it, a sandbox reset wipes the entire application state.
# Keep db/*.db-journal ignored (transient WAL files).
db/*.db-journal

# uploads — TRACKED (generated note HTML + carousel images)
# These are the actual note content. Build scripts can regenerate them,
# but committing them ensures instant recovery without re-running builds.
# (Previously gitignored — caused total content loss on sandbox reset.)

# agent context (internal work logs)
agent-ctx/
worklog.md
exact_text/
instagram_*/
upload/

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/tool-results/

# Agent private credentials (PAT etc.)
.agent-ctx/
